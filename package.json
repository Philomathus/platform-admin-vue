    "serve:prod": "npx vue-cli-service serve --mode prod",
    "build:local": "npx vue-cli-service build --mode local",
    "build:dev": "npx vue-cli-service build --mode dev",
    "build:prod": "npx vue-cli-service build --mode prod",
